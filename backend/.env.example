NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@db:5432/skillswap_toolshare
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=change-this-secret-to-at-least-32-characters
BETTER_AUTH_SECRETS=
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
# Dev: no password needed. Production: set REDIS_PASSWORD in your platform
# secrets and change REDIS_URL to redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=redis://redis:6379
EMAIL_RATE_LIMIT_PER_HOUR=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
# 32-byte hex key for AES-256-GCM message encryption — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_ENCRYPTION_KEY=7c5a9b1d8f3e4a2c0b6d7e9f1a8c5b3d2e0f4a6b9c1d8e7f5a3b2c0d9e4f1a6b
MEDIA_PATH=/app/media
# Secret for HMAC-SHA256 coordinate fuzzing — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FUZZ_SECRET=
